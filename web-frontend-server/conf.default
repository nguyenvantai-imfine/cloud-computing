server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  sub_filter '__SERVER_ID__' '$hostname';
  sub_filter_once off;
  add_header X-Served-By $hostname always;

  location / { try_files $uri $uri/ =404; }
  location = /metrics {
    resolver 127.0.0.11 valid=10s;
    set $metrics_backend web-nginx-exporter:9113;
    proxy_pass http://$metrics_backend/metrics;
  }

  location ^~ /blog/ {
    alias /usr/share/nginx/html/blog/;
    index index.html;
    autoindex off;
  }
}
server {
  listen 8081;

  location = /stub_status {
    stub_status;
  }
}
